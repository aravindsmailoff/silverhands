{
  "name": "hack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:ui": "next dev",
    "dev": "concurrently --names \"NEXT,PYTHON\" --prefix-colors \"cyan,yellow\" \"next dev\" \"npm run video:start\"",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "video:start": "cd video-backend && set PYTHONIOENCODING=utf-8&& uvicorn app:app --host 0.0.0.0 --port 8000 --reload",
    "video:install": "cd video-backend && pip install -r requirements.txt"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
